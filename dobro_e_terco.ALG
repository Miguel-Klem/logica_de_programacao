Algoritmo "Dobro e Terço"

// Autor(a)    : Klem
// Data atual  : 07/09/2026

Var

numero, terco, dobro: Real

Inicio

Escreva ("Escreva seu Número: ")
Leia (numero)
dobro <- (numero * 2)
terco <- (numero / 3)
limpatela
Escreval ("O Dobro de ", numero, " é ", dobro)
Escreva ("O Terço de ", numero, " é ", terco)

Fimalgoritmo