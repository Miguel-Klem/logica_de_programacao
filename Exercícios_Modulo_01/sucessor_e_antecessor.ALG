Algoritmo "Sucessor e Antecessor"

// Autor(a)    : Klem
// Data atual  : 07/09/2026

Var

numero, suc, ant: inteiro

Inicio

Escreva ("Insira o Número: ")
Leia (numero)
ant <- (numero - 1)
suc <- (numero + 1)
limpatela
Escreval ("O Antecessor de ", numero, " é: ", ant)
Escreva ("O Sucessor de ", numero, " é: ", suc)

Fimalgoritmo