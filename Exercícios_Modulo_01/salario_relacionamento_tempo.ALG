Algoritmo "Salário em relação a Tempo trabalhado"

// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 08/09/2026

Var

dia: Inteiro
salario: Real

Inicio

Escreva ("Informe a quantidade de Dia(s) trabalhados durante o mês: ")
Leia (dia)
salario <- (dia * 200)
Escreva ("Com a quantidade de Dia(s) trabalhados, o seu salário será de: ", salario:1:2, " R$")

Fimalgoritmo